generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(CANDIDATE)
  createdAt    DateTime      @default(now())
  jobs         Job[]
  applications Application[]
}

model Job {
  id             String        @id @default(uuid())
  title          String
  description    String
  requiredSkills String[]
  minExperience  Int           @default(0)
  recruiterId    String
  recruiter      User          @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id               String            @id @default(uuid())
  candidateId      String
  candidate        User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeFileName   String
  parsedName       String?
  parsedEmail      String?
  parsedPhone      String?
  parsedSkills     String[]
  parsedEducation  String?
  parsedExperience String?
  experienceYears  Float             @default(0)
  cosineScore      Float             @default(0)
  finalScore       Float             @default(0)
  skillGaps        String[]
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  @@unique([candidateId, jobId])
}
